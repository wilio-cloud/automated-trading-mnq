# ==============================================================================
# TRADOVATE CONFIGURATION (DEMO / LIVE)
# ==============================================================================
# Canvia a "live" quan passis a real amb els 1.000$
TRADOVATE_ENV=demo

# Credencials d'accés a Tradovate
TRADOVATE_USER=el_teu_usuari
TRADOVATE_PASS=la_teva_contrasenya

# Credencials d'API (obtingudes a Tradovate -> Settings -> Add-ons / API Access)
TRADOVATE_APP_ID=MNQZonesBot
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=
TRADOVATE_SEC=el_teu_api_secret

# Compte específic (opcional, si es deixa buit agafarà el primer compte actiu)
TRADOVATE_ACCOUNT_ID=
TRADOVATE_ACCOUNT_SPEC=

# ==============================================================================
# PARÀMETRES DE L'ESTRATÈGIA (SWEET SPOT LONDRES)
# ==============================================================================
SYMBOL_BASE=MNQ
TP_POINTS=10.0
SL_POINTS=60.0

# Gestió de Risc i Escalat
INITIAL_CONTRACTS=1
AUTO_SCALE=true
# Llindars d'escalat de capital ($)
SCALE_THRESHOLD_2_CONTRACTS=2200.0
SCALE_THRESHOLD_3_CONTRACTS=3500.0
SCALE_THRESHOLD_4_CONTRACTS=4800.0

# ==============================================================================
# HORARIS OPERATIUS (Timezone America/New_York)
# ==============================================================================
# Sessió de Londres: 02:00 a 05:00 EDT (08:00 a 11:00 CEST)
LONDON_START_HOUR=2
LONDON_START_MINUTE=0
LONDON_END_HOUR=5
LONDON_END_MINUTE=0

# Tancament CME EOD: 16:55 EDT (22:55 CEST)
EOD_CLOSE_HOUR=16
EOD_CLOSE_MINUTE=55

# ==============================================================================
# NOTIFICACIONS (DISCORD / TELEGRAM)
# ==============================================================================
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
